#!/bin/sh
# The one entry point. Everything lives in .workspace/bin/workspace.py.
#
# POSIX sh, not zsh: a template is cloned onto machines that do not have zsh,
# including every Linux CI runner. `${0:A:h}` was zsh-only and failed there with
# "required file not found", which names the shell rather than the problem.
#
# Extensionless so Obsidian's file explorer never shows it.
dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
exec python3 "$dir/.workspace/bin/workspace.py" "$@"
