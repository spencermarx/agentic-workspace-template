{
  "$schema": "../schema/plan.schema.json",
  "nodes": [
    { "path": "Areas", "role": "router", "title": "Areas",
      "instanceRole": "leaf", "instanceTemplate": true },
    { "path": "Areas/example-area", "role": "leaf", "title": "Example Area",
