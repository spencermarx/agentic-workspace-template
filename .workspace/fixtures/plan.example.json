      "files": [{ "name": "Example Area - Parking Lot.md", "template": "parking-lot" }] },
    { "path": "Operators", "role": "router", "title": "Operators",
      "instanceRole": "leaf", "instanceTemplate": true },
    { "path": "Operators/operator", "role": "leaf", "title": "Operator",
      "slots": { "purpose": "One person's own working area. Skills resolve the session user to a folder here." },
      "scaffold": ["Daily Notes"],
      "files": [{ "name": "Operator - Parking Lot.md", "template": "parking-lot" }] },
    { "path": "Meetings", "role": "plain", "title": "Meetings", "gitkeep": true },
    { "path": "People", "role": "plain", "title": "People", "gitkeep": true },
    { "path": "Attachments", "role": "plain", "title": "Attachments", "gitkeep": true }
  ]
