{
  "$schema": "../schema/plan.schema.json",
  "planVersion": 1,
  "shape": { "primaryMultiplicity": "clients", "kind": "consultancy" },
  "nodes": [
    { "path": "Business", "role": "leaf", "title": "Business", "template": "leaf",
      "scaffold": ["Activities", "Documents"],
      "files": [{ "name": "Business - Parking Lot.md", "template": "parking-lot" }],
      "children": ["decisions"] },
    { "path": "Clients", "role": "router", "title": "Clients", "template": "router",
      "instanceTemplate": "leaf", "instanceRole": "leaf", "instanceNaming": "kebab",
      "children": ["_archive"] },
    { "path": "Offerings", "role": "router", "title": "Offerings", "template": "router",
      "instanceTemplate": "leaf", "instanceRole": "leaf", "instanceNaming": "kebab" },
    { "path": "Pipeline", "role": "leaf", "title": "Pipeline", "template": "leaf",
      "scaffold": ["Leads", "Proposals", "SOWs", "_lost"],
      "files": [{ "name": "Pipeline - Parking Lot.md", "template": "parking-lot" }] },
    { "path": "Products", "role": "router", "title": "Products", "template": "router",
      "instanceTemplate": "leaf", "instanceRole": "leaf", "instanceNaming": "kebab" },
    { "path": "Operators", "role": "router", "title": "Operators", "template": "router",
      "instanceTemplate": "leaf", "instanceRole": "leaf" },
    { "path": "Operators/operator", "role": "leaf", "title": "Operator", "template": "leaf",
      "person": "operator",
      "scaffold": ["Daily Notes", "Weekly Reviews", "Weekly Goals", "Coaching", "Inbox"] },
    { "path": "Meetings", "role": "plain", "title": "Meetings", "gitkeep": true },
    { "path": "People", "role": "plain", "title": "People", "gitkeep": true },
    { "path": "Attachments", "role": "plain", "title": "Attachments", "gitkeep": true }
  ]
}
