# Sorted by staleness, ascending, on purpose.
#
# A person directory sorted by name is a list. Sorted by how long since you last
# touched the note, it is a reconnect queue: the top row is who you have gone
# longest without speaking to.
#
# Staleness is file.mtime, not a hand-written `updated` property. The property
# version sorted by creation date, because nothing ever refreshed it.
filters:
  and:
    - 'type == "person"'
views:
  - type: table
    name: Reconnect queue
    order:
      - file.name
      - relationship
      - orgs
      - file.mtime
    sort:
      - property: file.mtime
        direction: ASC
  # Internal and external are a property rather than two folders, because people
  # cross the line and a re-file is a rename that breaks every link to them.
  # This view is what a folder split would have bought, without the cost.
  - type: table
    name: Team and counterparts
    groupBy:
      property: relationship
      direction: ASC
    order:
      - file.name
      - orgs
      - status
